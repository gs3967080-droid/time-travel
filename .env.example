# 复制为 .env 后填入，即可让「时间线推演」改由大模型生成
# 不填也能跑：会自动使用内置的本地推演引擎（零延迟、断网可用）

# OpenAI 兼容端点：
#   DeepSeek  https://api.deepseek.com/v1
#   OpenAI    https://api.openai.com/v1
#   Ollama    http://127.0.0.1:11434/v1   （本地模型，API Key 随便填）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 可选：单次推演超时（毫秒），超时自动回落本地引擎
LLM_TIMEOUT_MS=15000

# 可选：如果模型接口需要走代理，取消下面注释，并用 `npm run server:proxy` 启动
# HTTPS_PROXY=http://127.0.0.1:7897

{
  "name": "time-travel-history-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "时空跃迁：历史枢纽 — 赛博古风系统穿越流沉浸式 Web 体验",
  "scripts": {
    "dev": "node scripts/run.js node_modules/vite/bin/vite.js frontend --host 0.0.0.0",
    "dev:all": "node backend/dev.js",
    "build": "node scripts/run.js node_modules/vite/bin/vite.js build frontend",
    "preview": "node scripts/run.js node_modules/vite/bin/vite.js preview frontend --host 0.0.0.0",
    "server": "node --experimental-sqlite backend/index.js",
    "server:proxy": "node --use-env-proxy --experimental-sqlite backend/index.js",
    "start": "node --experimental-sqlite backend/index.js",
    "db:reset": "node --experimental-sqlite database/reset.js"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-globe.gl": "^2.38.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
